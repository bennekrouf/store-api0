# store-api0 environment

# Postgres connection string
DATABASE_URL=

# Shared secret authenticating the gateway to this service. Every credential
# route requires it and fails closed when unset, so it must match the value the
# gateway process uses.
API0_INTERNAL_SECRET=

# Key sealing per-user downstream credentials (AES-256-GCM).
# 32 random bytes, base64:  openssl rand -base64 32
# Losing or changing it makes every stored credential unreadable — users would
# have to add their tokens again.
API0_ENCRYPTION_KEY=
